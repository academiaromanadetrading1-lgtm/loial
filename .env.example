# EXEMPLU FARA DATE REALE. Configureaza valorile in managerul de secrete al gazduirii.
JWT_SECRET_KEY=
ALLOWED_ORIGINS=https://loial.space
LOIAL_AI_OPENAI_API_KEY=
LOIAL_AI_ECONOMY_MODEL=gpt-4.1-nano
LOIAL_AI_ADVANCED_MODEL=
LOIAL_AI_INPUT_USD_PER_M=
LOIAL_AI_OUTPUT_USD_PER_M=
LOIAL_AI_ADVANCED_INPUT_USD_PER_M=
LOIAL_AI_ADVANCED_OUTPUT_USD_PER_M=
LOIAL_AI_USD_TO_EUR=
LOIAL_AI_MONTHLY_BUDGET_EUR=5
# Mesajele catre clienti sunt livrate exclusiv in portofelul Loial, fara chei externe.
# Optional, pentru crearea primului administrator; nu folosi parole hardcodate.
LOIAL_ADMIN_BOOTSTRAP_EMAIL=
LOIAL_ADMIN_BOOTSTRAP_PASSWORD=
# Default: no new integration costs. Use temporary SQLite only for CI.
LOIAL_DATABASE_URL=sqlite:////data/loial.db
LOIAL_WEEKLY_JOBS_ENABLED=1

# Integrare oficiala Apple Wallet. Nu copia certificatele in repository.
LOIAL_APPLE_PASS_TYPE_ID=
LOIAL_APPLE_TEAM_ID=
LOIAL_APPLE_PASS_CERT_PEM=
LOIAL_APPLE_PASS_KEY_PEM=
LOIAL_APPLE_WWDR_CERT_PEM=

# Integrare oficiala Google Wallet. Service account JSON ramane secret.
# Un singur emitent Loial. In pilot, fiecare firma primeste automat o clasa
# Loyalty proprie (logo Loial, fundal negru, numele afacerii).
# Clasa Generic pentru ambasador poate fi pregatita de acelasi emitent.
LOIAL_GOOGLE_MERCHANT_CLASSES=1
LOIAL_APPLE_PILOT_ENABLED=0
LOIAL_GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
LOIAL_GOOGLE_LOYALTY_CLASS_ID=
LOIAL_GOOGLE_AMBASSADOR_CLASS_ID=

# Apple PassKit update web service (optional, only after official issuer setup).
# Use HTTPS and cryptographically random independent secrets in the hosting secret manager.
LOIAL_APPLE_WEB_SERVICE_URL=
LOIAL_APPLE_PASS_AUTH_SECRET=
LOIAL_APPLE_PUSH_TOKEN_FERNET_KEY=
# APNs device push sender is not yet active; do not promise automatic iPhone updates.

# Google Wallet existing loyaltyObject updates: explicit opt-in, OFF until verified.
LOIAL_GOOGLE_WALLET_SYNC_ENABLED=0

# Stripe LOIAL – opțional în STAGING, obligatoriu înainte de lansarea PROBUSINESS.
# Folosește cont STRIPE dedicat LOIAL. Nu reutiliza contul altui proiect.
# Produs: EUR 67 / lună, cu TVA neadăugat în configurația actuală.
# Doar în managerul de secrete; nu salva chei reale în Git.
LOIAL_STRIPE_SECRET_KEY=
LOIAL_STRIPE_PRICE_ID=
LOIAL_STRIPE_WEBHOOK_SECRET=
LOIAL_PUBLIC_ORIGIN=https://loial.space
